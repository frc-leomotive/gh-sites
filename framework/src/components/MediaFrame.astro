---
import PlaceholderBlock from './PlaceholderBlock.astro';
import { isVideoMedia, type MediaReference } from '../media-reference';
import { withBasePath } from '../site-path';

interface Props {
  media?: MediaReference;
  placeholderLabel: string;
  eager?: boolean;
}

const { media, placeholderLabel, eager = false } = Astro.props;
---

{
  media ? (
    <figure class="media-frame">
      {isVideoMedia(media) ? (
        <video
          src={withBasePath(media.src)}
          poster={withBasePath(media.poster ?? '')}
          width={media.intrinsicWidth}
          height={media.intrinsicHeight}
          preload={eager ? 'metadata' : 'none'}
          aria-label={media.alt}
          controls
          playsinline
        >
          {media.captions?.map((caption) => (
            <track
              kind="captions"
              src={withBasePath(caption.src)}
              srclang={caption.srclang}
              label={caption.label}
              default={caption.default}
            />
          ))}
          {media.alt}
        </video>
      ) : (
        <img
          src={withBasePath(media.src)}
          alt={media.alt}
          width={media.intrinsicWidth}
          height={media.intrinsicHeight}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      )}
    </figure>
  ) : (
    <PlaceholderBlock label={placeholderLabel} kind="media" />
  )
}
