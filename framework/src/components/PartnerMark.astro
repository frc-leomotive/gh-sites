---
import type { CollectionEntry } from 'astro:content';
import { withBasePath } from '../site-path';

type PageData = CollectionEntry<'page'>['data'];
type Partner = NonNullable<PageData['partners']>['items'][number];

interface Props {
  partner: Partner;
}

const { partner } = Astro.props;
---

{
  partner.logo ? (
    <img
      src={withBasePath(partner.logo.src)}
      alt={partner.logo.alt}
      width={partner.logo.intrinsicWidth}
      height={partner.logo.intrinsicHeight}
      loading="lazy"
    />
  ) : (
    <span>{partner.name}</span>
  )
}
